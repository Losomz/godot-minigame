#!/usr/bin/env python
import os
import sys

REPO_ROOT = os.path.abspath(os.getcwd())
PLUGIN_ROOT = os.path.join(REPO_ROOT, "plugin")
BUILD_ROOT = os.path.join(PLUGIN_ROOT, "build")
GODOT_CPP_ROOT = os.path.join(PLUGIN_ROOT, "thirdparty", "godot-cpp")
sys.path.insert(0, BUILD_ROOT)

from methods import print_error

libname = "godot-minigame"

localEnv = Environment(tools=["default"], PLATFORM="")

# 读取命令行的 platform / arch（如果 custom.py 没有定义，可以用 ARGUMENTS 读取）
platform = ARGUMENTS.get("platform", "windows")  # 默认 windows，自行调整
arch = ARGUMENTS.get("arch", "x86_64")

localEnv["platform"] = platform
localEnv["arch"] = arch

# Use osxcross only when an explicit cross-compilation toolchain is configured.
if platform == "macos" and os.environ.get("OSXCROSS_ROOT"):
    osxcross_root = os.environ["OSXCROSS_ROOT"]
    
    # 这里的 triplet 要和你 build osxcross 时生成的一致，可以在 $OSXCROSS_ROOT/target/bin 里 ls 看看
    triplet = "x86_64-apple-darwin25.1"  # 示例：macOS 14 SDK，对 x86_64
    if arch == "arm64":
        triplet = "aarch64-apple-darwin25.1"
    
    localEnv["CC"] = f"{triplet}-clang"
    localEnv["CXX"] = f"{triplet}-clang++"
    
    # macOS 动态库后缀
    localEnv["SHLIBSUFFIX"] = ".dylib"
    
    # 最小部署版本、C++ 标准库等
    min_ver = os.environ.get("MACOSX_DEPLOYMENT_TARGET", "14.0")
    localEnv.Append(CCFLAGS=[
        "-std=c++17",
        f"-mmacosx-version-min={min_ver}",
        "-stdlib=libc++",
    ])
    localEnv.Append(LINKFLAGS=[
        f"-mmacosx-version-min={min_ver}",
        "-stdlib=libc++",
    ])


# Build profiles can be used to decrease compile times.
# You can either specify "disabled_classes", OR
# explicitly specify "enabled_classes" which disables all other classes.
# Modify the example file as needed and uncomment the line below or
# manually specify the build_profile parameter when running SCons.

# localEnv["build_profile"] = "build_profile.json"

customs = [os.path.join(BUILD_ROOT, "custom.py")]

opts = Variables(customs, ARGUMENTS)
opts.Add(BoolVariable("embed_resources", "Embed plugin resources and catalogs", False))
opts.Update(localEnv)
ARGUMENTS.pop("embed_resources", None)

Help(opts.GenerateHelpText(localEnv))

env = localEnv.Clone()

if not (os.path.isdir(GODOT_CPP_ROOT) and os.listdir(GODOT_CPP_ROOT)):
    print_error("""godot-cpp is not available within this folder, as Git submodules haven't been initialized.
Run the following command to download godot-cpp:

    git submodule update --init --recursive""")
    sys.exit(1)

env = SConscript(os.path.join(GODOT_CPP_ROOT, "SConstruct"), {"env": env, "customs": customs})

env.Append(CPPPATH=[os.path.join(PLUGIN_ROOT, "src"), os.path.join(PLUGIN_ROOT, "include")])

# Add all subdirectories recursively
import os
sources = []
for root, dirs, files in os.walk(os.path.join(PLUGIN_ROOT, "src")):
    for file in files:
        if file.endswith(".cpp") and not file.endswith(".gen.cpp"):
            sources.append(os.path.join(root, file).replace("\\", "/"))

if env["target"] in ["editor", "template_debug"]:
    try:
        doc_data = env.GodotCPPDocData(
            os.path.join(PLUGIN_ROOT, "src", "gen", "doc_data.gen.cpp"),
            source=Glob(os.path.join(PLUGIN_ROOT, "doc_classes", "*.xml")),
        )
        sources.append(doc_data)
    except AttributeError:
        print("Not including class reference as we're targeting a pre-4.3 baseline.")

# Resource embedding support
if env["embed_resources"]:
    print("Building with embedded resources...")
    env.Append(CPPDEFINES=["EMBED_RESOURCES"])
    
    # Add resource files to build
    resource_files = []
    resources_root = os.path.join(PLUGIN_ROOT, "resources")
    if os.path.exists(resources_root):
        for root, dirs, files in os.walk(resources_root):
            for file in files:
                if file.endswith((".zip", ".tpz", ".js", ".json", ".yaml", ".yml", ".svg", ".png", ".jpg", ".jpeg", ".webp")):
                    resource_files.append(os.path.join(root, file))
    catalog_file = os.path.join(PLUGIN_ROOT, "catalog", "templates.json")
    if os.path.isfile(catalog_file):
        resource_files.append(catalog_file)
    
    if resource_files:
        # Generate resource header
        python_exec = sys.executable
        resource_gen = env.Command(
            os.path.join(PLUGIN_ROOT, "src", "resources", "embedded_resources.gen.cpp"),
            resource_files,
            f'"{python_exec}" "{os.path.join(PLUGIN_ROOT, "tools", "embed_resources.py")}" $SOURCES $TARGET',
        )
        sources.append(resource_gen)

# .dev doesn't inhibit compatibility, so we don't need to key it.
# .universal just means "compatible with all relevant arches" so we don't need to key it.
suffix = env['suffix'].replace(".dev", "").replace(".universal", "").replace(".editor", "").replace(".template_debug", "").replace(".template_release", "")

lib_filename = "{}{}{}{}".format(env.subst('$SHLIBPREFIX'), libname, suffix, env.subst('$SHLIBSUFFIX'))

library = env.SharedLibrary(
    os.path.join(REPO_ROOT, "dist", "plugin", "native", env["platform"], lib_filename),
    source=sources,
)

waiter_platform = "macos" if platform == "macos" else platform
waiter_arch = "" if platform == "macos" else ".{}".format(arch)
waiter_extension = ".exe" if platform == "windows" else ""
waiter_filename = "godot-minigame-update-waiter.{}{}{}".format(waiter_platform, waiter_arch, waiter_extension)
waiter_env = env.Clone()
waiter_env.Replace(LIBS=[], LIBPATH=[])
waiter = waiter_env.Program(
    os.path.join(REPO_ROOT, "dist", "plugin", "native", env["platform"], waiter_filename),
    source=[os.path.join(PLUGIN_ROOT, "updater", "update_waiter.cpp")],
)

Default([library, waiter])
